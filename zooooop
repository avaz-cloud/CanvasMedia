<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Canvas · Design · Branding · Websites · Marketing | Guernsey</title>
<meta name="description" content="Canvas is a boutique creative agency in Guernsey helping businesses build memorable brands through strategy, design, websites, photography and marketing.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,400&family=Inter:wght@400;450;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
/* ============================================================
   CANVAS - design tokens
   ============================================================ */
:root{
  --paper:#F7F5F2;
  --paper-raised:#FBFAF8;
  --ink:#1F1F1F;
  --ink-soft:#4c4a46;
  --forest:#355E4B;
  --forest-deep:#24402F;
  --sage:#A8B8A5;
  --sage-tint:#E4E9E2;
  --hairline:rgba(31,31,31,.14);
  --hairline-light:rgba(247,245,242,.22);

  --font-display:'Fraunces', Georgia, serif;
  --font-body:'Inter', -apple-system, sans-serif;
  --font-mono:'Space Mono', monospace;

  --gutter:clamp(1.25rem, 4vw, 4rem);
  --max:1440px;

  --ease-out:cubic-bezier(.22,1,.36,1);
  --dur:.7s;
}

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
html:focus-within{scroll-behavior:smooth}
body{
  background:var(--paper);
  color:var(--ink);
  font-family:var(--font-body);
  font-size:1.0625rem;
  line-height:1.65;
  font-weight:450;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
img,svg{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font:inherit;background:none;border:0;cursor:pointer;color:inherit}
::selection{background:var(--forest);color:var(--paper)}

:focus-visible{outline:2px solid var(--forest);outline-offset:3px}

.wrap{max-width:var(--max);margin-inline:auto;padding-inline:var(--gutter)}

/* mono eyebrow label - encodes section index in a real document order */
.tag{
  font-family:var(--font-mono);
  font-size:.6875rem;
  letter-spacing:.22em;
  text-transform:uppercase;
  color:var(--forest);
  display:flex;align-items:center;gap:.9rem;
}
.tag::after{content:"";height:1px;width:3.5rem;background:var(--forest);opacity:.45}
.tag--light{color:var(--sage)}
.tag--light::after{background:var(--sage)}

/* ============================================================
   Reveal-on-scroll primitives (JS adds .in)
   ============================================================ */
.r{opacity:0;transform:translateY(26px);transition:opacity var(--dur) var(--ease-out),transform var(--dur) var(--ease-out)}
.r.in{opacity:1;transform:none}
.r-d1{transition-delay:.08s}
.r-d2{transition-delay:.16s}
.r-d3{transition-delay:.24s}
.r-d4{transition-delay:.32s}

/* image reveal - curtain wipe, not a fade */
.reveal-img{position:relative;overflow:hidden}
.reveal-img::after{
  content:"";position:absolute;inset:0;background:var(--paper);
  transform:scaleY(1);transform-origin:top;
  transition:transform .9s var(--ease-out);
}
.reveal-img.in::after{transform:scaleY(0);transform-origin:bottom}
.reveal-img--dark::after{background:var(--forest-deep)}

@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .r,.reveal-img::after{transition:none}
  .r{opacity:1;transform:none}
  .reveal-img::after{display:none}
  *{animation-duration:.01ms !important;animation-iteration-count:1 !important}
}

/* ============================================================
   Header
   ============================================================ */
.site-header{
  position:fixed;inset-inline:0;top:0;z-index:100;
  transition:background .45s var(--ease-out),box-shadow .45s var(--ease-out),transform .45s var(--ease-out);
}
.site-header .wrap{
  display:flex;align-items:center;justify-content:space-between;
  padding-block:1.6rem;
  transition:padding .45s var(--ease-out);
}
.site-header.scrolled{
  background:rgba(247,245,242,.88);
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  box-shadow:0 1px 0 var(--hairline);
}
.site-header.scrolled .wrap{padding-block:.9rem}
.site-header.hidden-up{transform:translateY(-100%)}

.logo{
  font-family:var(--font-display);
  font-size:1.45rem;font-weight:600;letter-spacing:-.01em;
  display:flex;align-items:baseline;gap:.4rem;
}
.logo .dot{width:.44em;height:.44em;background:var(--forest);border-radius:50%;transform:translateY(-.05em);transition:transform .4s var(--ease-out)}
.logo:hover .dot{transform:translateY(-.05em) scale(1.35)}

.nav-links{display:flex;gap:2.4rem;list-style:none;align-items:center}
.nav-links a{
  font-size:.9rem;font-weight:500;letter-spacing:.01em;
  position:relative;padding-block:.3rem;
}
.nav-links a:not(.nav-cta)::after{
  content:"";position:absolute;left:0;bottom:0;height:1px;width:100%;
  background:var(--ink);transform:scaleX(0);transform-origin:right;
  transition:transform .4s var(--ease-out);
}
.nav-links a:not(.nav-cta):hover::after,
.nav-links a:not(.nav-cta)[aria-current="true"]::after{transform:scaleX(1);transform-origin:left}

.nav-cta{
  font-family:var(--font-mono);font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;
  border:1px solid var(--ink);padding:.65rem 1.3rem;
  transition:background .35s var(--ease-out),color .35s var(--ease-out);
}
.nav-cta:hover{background:var(--ink);color:var(--paper)}

.menu-btn{display:none;flex-direction:column;gap:6px;padding:.5rem;z-index:110}
.menu-btn span{width:26px;height:1.5px;background:var(--ink);transition:transform .4s var(--ease-out),opacity .3s}
.menu-btn[aria-expanded="true"] span:nth-child(1){transform:translateY(7.5px) rotate(45deg)}
.menu-btn[aria-expanded="true"] span:nth-child(2){opacity:0}
.menu-btn[aria-expanded="true"] span:nth-child(3){transform:translateY(-7.5px) rotate(-45deg)}

/* ============================================================
   Hero
   ============================================================ */
.hero{
  min-height:100svh;
  display:flex;flex-direction:column;justify-content:flex-end;
  position:relative;
  padding-top:7rem;
}
.hero-grid{
  display:grid;
  grid-template-columns:1fr minmax(0,340px);
  gap:clamp(2rem,5vw,6rem);
  align-items:end;
  padding-bottom:clamp(3rem,7vh,6rem);
}
.hero h1{
  font-family:var(--font-display);
  font-weight:400;
  font-size:clamp(2.9rem, 8.2vw, 7.6rem);
  line-height:1.02;
  letter-spacing:-.025em;
  max-width:14ch;
}
.hero h1 .line{display:block;overflow:hidden}
.hero h1 .line > span{display:block;transform:translateY(110%);animation:heroLine 1.1s var(--ease-out) forwards}
.hero h1 .line:nth-child(2) > span{animation-delay:.12s}
.hero h1 .line:nth-child(3) > span{animation-delay:.24s}
@keyframes heroLine{to{transform:none}}

.hero h1 em{
  font-style:italic;font-weight:300;color:var(--forest);
  position:relative;white-space:nowrap;
}
/* the signature brushstroke, drawn under "remember" */
.stroke-u{
  position:absolute;left:-2%;bottom:-.12em;width:104%;height:.34em;
  pointer-events:none;overflow:visible;
}
.stroke-u path{
  fill:none;stroke:var(--sage);stroke-width:7;stroke-linecap:round;
  stroke-dasharray:320;stroke-dashoffset:320;
  animation:drawStroke 1.2s var(--ease-out) .9s forwards;
}
@keyframes drawStroke{to{stroke-dashoffset:0}}

.hero-side{padding-bottom:.6rem}
.hero-side p{
  font-size:1.02rem;color:var(--ink-soft);max-width:34ch;
  margin-block:1.2rem 2rem;
}
.hero-kicker{
  font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.22em;
  text-transform:uppercase;color:var(--forest);
}

.btn{
  display:inline-flex;align-items:center;gap:.85rem;
  font-family:var(--font-mono);font-size:.78rem;letter-spacing:.15em;text-transform:uppercase;
  color:var(--paper);background:var(--forest);
  padding:1.05rem 1.7rem;
  position:relative;overflow:hidden;
  transition:color .01s;
}
.btn > *{position:relative;z-index:1}
.btn::before{
  content:"";position:absolute;inset:0;background:var(--ink);
  transform:translateY(101%);transition:transform .45s var(--ease-out);
}
.btn:hover::before{transform:none}
.btn .arr{transition:transform .45s var(--ease-out)}
.btn:hover .arr{transform:translateX(5px)}

.btn--ghost{background:transparent;color:var(--ink);border:1px solid var(--ink)}
.btn--ghost::before{background:var(--ink)}
.btn--ghost:hover{color:var(--paper)}

/* ============================================================
   Marquee strip - quiet, one row, pauses on hover
   ============================================================ */
.strip{
  border-block:1px solid var(--hairline);
  overflow:hidden;padding-block:1.3rem;
  background:var(--paper-raised);
}
.strip-track{
  display:flex;gap:4.5rem;width:max-content;
  animation:marquee 36s linear infinite;
}
.strip:hover .strip-track{animation-play-state:paused}
.strip span{
  font-family:var(--font-display);font-style:italic;font-weight:300;
  font-size:1.05rem;color:var(--ink-soft);white-space:nowrap;
  display:flex;align-items:center;gap:4.5rem;
}
.strip .sep{width:5px;height:5px;background:var(--sage);border-radius:50%;flex:none}
@keyframes marquee{to{transform:translateX(-50%)}}
@media (prefers-reduced-motion:reduce){.strip-track{animation:none;flex-wrap:wrap}}

/* ============================================================
   Section scaffolding
   ============================================================ */
.section{padding-block:clamp(5rem,11vw,9.5rem)}
.section-head{
  display:grid;grid-template-columns:auto 1fr;gap:2.5rem;align-items:start;
  margin-bottom:clamp(3rem,6vw,5.5rem);
}
.section-head h2{
  font-family:var(--font-display);font-weight:400;
  font-size:clamp(2.1rem,4.6vw,3.9rem);
  line-height:1.06;letter-spacing:-.02em;
  max-width:18ch;
}
.section-head .lede{
  grid-column:2;max-width:52ch;color:var(--ink-soft);margin-top:1.3rem;
}
</style>
<style>
/* ============================================================
   Services - a ruled ledger, not cards
   ============================================================ */
.services-list{border-top:1px solid var(--hairline)}
.service{
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(0,1.4fr) auto;
  gap:clamp(1.5rem,4vw,4rem);
  align-items:center;
  padding-block:2.1rem;
  border-bottom:1px solid var(--hairline);
  position:relative;
  transition:padding .45s var(--ease-out);
}
.service::before{
  content:"";position:absolute;inset-inline:0;top:0;height:0;
  background:var(--sage-tint);z-index:-1;
  transition:height .45s var(--ease-out);
}
.service:hover::before{height:100%}
.service:hover{padding-left:1.4rem;padding-right:1.4rem}
.service h3{
  font-family:var(--font-display);font-weight:400;
  font-size:clamp(1.4rem,2.6vw,2.1rem);letter-spacing:-.015em;
}
.service p{color:var(--ink-soft);font-size:.98rem;max-width:44ch}
.service .glyph{
  width:52px;height:52px;flex:none;color:var(--forest);
  transition:transform .5s var(--ease-out);
}
.service:hover .glyph{transform:rotate(-6deg) scale(1.08)}
.service .glyph svg{width:100%;height:100%}
.service .glyph path,.service .glyph circle,.service .glyph line,.service .glyph rect,.service .glyph polyline{
  fill:none;stroke:currentColor;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round;
}

/* ============================================================
   Process - one drawn line down the page
   ============================================================ */
.process-flow{position:relative;max-width:880px;margin-inline:auto}
.process-spine{
  position:absolute;left:25px;top:0;bottom:0;width:2px;overflow:visible;
}
.process-spine path{
  fill:none;stroke:var(--sage);stroke-width:2.5;
  stroke-dasharray:1;stroke-dashoffset:1;
}
.step{
  display:grid;grid-template-columns:52px 1fr;gap:clamp(1.5rem,4vw,3.2rem);
  padding-block:clamp(1.8rem,4vw,3rem);
  position:relative;
}
.step-node{
  width:52px;height:52px;border-radius:50%;
  border:1px solid var(--forest);
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-mono);font-size:.72rem;color:var(--forest);
  background:var(--paper);
  position:relative;z-index:1;
  transition:background .4s var(--ease-out),color .4s var(--ease-out),transform .4s var(--ease-out);
}
.step.in .step-node,.step:hover .step-node{background:var(--forest);color:var(--paper);transform:scale(1.06)}
.step-body{max-width:56ch}
.step h3{
  font-family:var(--font-display);font-weight:400;
  font-size:clamp(1.5rem,3vw,2.2rem);letter-spacing:-.015em;
  display:flex;align-items:baseline;gap:1rem;flex-wrap:wrap;
}
.step h3 .step-verb{font-style:italic;font-weight:300;color:var(--forest);font-size:.62em}
.step p{color:var(--ink-soft);margin-top:.7rem}
.step:nth-child(even) .step-body{margin-left:clamp(0rem,6vw,5rem)}

/* ============================================================
   About - split editorial
   ============================================================ */
.about-grid{
  display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);
  gap:clamp(2.5rem,6vw,6.5rem);align-items:start;
}
.about-lead{position:sticky;top:7rem}
.about-lead .big{
  font-family:var(--font-display);font-weight:400;
  font-size:clamp(1.8rem,3.6vw,3rem);line-height:1.18;letter-spacing:-.02em;
  margin-top:1.6rem;max-width:16ch;
}
.about-lead .big em{font-style:italic;font-weight:300;color:var(--forest)}
.about-copy .big{
  font-family:var(--font-display);font-weight:400;
  font-size:clamp(1.55rem,2.9vw,2.3rem);line-height:1.28;letter-spacing:-.015em;
  margin-block:1.8rem 1.6rem;
}
.about-copy .big em{font-style:italic;font-weight:300;color:var(--forest)}
.about-copy p:not(.big){color:var(--ink-soft);max-width:56ch;margin-bottom:1.1rem}

.about-figures{
  display:flex;gap:3.2rem;margin-top:2.6rem;padding-top:2rem;
  border-top:1px solid var(--hairline);flex-wrap:wrap;
}
.fig .n{
  font-family:var(--font-display);font-weight:300;font-size:2.6rem;letter-spacing:-.02em;
  color:var(--forest);
}
.fig .l{font-family:var(--font-mono);font-size:.66rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-soft)}


/* ============================================================
   Contact
   ============================================================ */
.contact-grid{
  display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);
  gap:clamp(2.5rem,6vw,7rem);align-items:start;
}
.contact-head h2{
  font-family:var(--font-display);font-weight:400;
  font-size:clamp(2.6rem,6vw,5.2rem);line-height:1.04;letter-spacing:-.025em;
  margin-block:1.6rem 1.4rem;max-width:12ch;
}
.contact-head h2 em{font-style:italic;font-weight:300;color:var(--forest)}
.contact-head p{color:var(--ink-soft);max-width:44ch;margin-bottom:2.4rem}
.contact-details{display:grid;gap:1.4rem;border-top:1px solid var(--hairline);padding-top:2rem}
.cd{display:grid;gap:.15rem}
.cd .k{font-family:var(--font-mono);font-size:.64rem;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-soft)}
.cd a{font-family:var(--font-display);font-size:1.25rem;font-weight:400;width:fit-content;position:relative}
.cd a::after{content:"";position:absolute;left:0;bottom:0;height:1px;width:100%;background:var(--forest);transform:scaleX(0);transform-origin:right;transition:transform .4s var(--ease-out)}
.cd a:hover::after{transform:scaleX(1);transform-origin:left}

.contact-form{display:grid;gap:2rem;padding-top:.6rem}
.field{position:relative}
.field input,.field textarea{
  width:100%;background:transparent;border:0;border-bottom:1px solid var(--hairline);
  padding:1.4rem 0 .8rem;font:inherit;color:var(--ink);
  transition:border-color .35s;
  resize:vertical;
}
.field textarea{min-height:7.5rem}
.field label{
  position:absolute;left:0;top:1.35rem;color:var(--ink-soft);
  pointer-events:none;transition:all .35s var(--ease-out);
  font-size:1rem;
}
.field input:focus,.field textarea:focus{outline:none;border-color:var(--forest)}
.field input:focus + label,.field textarea:focus + label,
.field input:not(:placeholder-shown) + label,.field textarea:not(:placeholder-shown) + label{
  top:0;font-size:.66rem;font-family:var(--font-mono);letter-spacing:.18em;text-transform:uppercase;color:var(--forest);
}
.field .bar{position:absolute;left:0;bottom:0;height:1px;width:100%;background:var(--forest);transform:scaleX(0);transform-origin:left;transition:transform .5s var(--ease-out)}
.field input:focus ~ .bar,.field textarea:focus ~ .bar{transform:scaleX(1)}
.form-note{font-size:.85rem;color:var(--ink-soft)}
.form-sent{
  display:none;padding:1.1rem 1.3rem;border:1px solid var(--forest);
  color:var(--forest);font-size:.92rem;
}
.form-sent.show{display:block}

/* ============================================================
   Footer
   ============================================================ */
.site-footer{background:var(--forest-deep);color:var(--paper)}
.footer-top{
  display:grid;grid-template-columns:minmax(0,1.4fr) repeat(2,minmax(0,1fr));
  gap:clamp(2rem,5vw,5rem);
  padding-block:clamp(3.5rem,7vw,5.5rem) clamp(2.5rem,5vw,4rem);
}
.footer-brand .logo{color:var(--paper);font-size:1.7rem}
.footer-brand .logo .dot{background:var(--sage)}
.footer-brand p{color:var(--sage);font-size:.95rem;max-width:32ch;margin-top:1.1rem}
.footer-col h4{
  font-family:var(--font-mono);font-size:.66rem;letter-spacing:.2em;text-transform:uppercase;
  color:var(--sage);margin-bottom:1.2rem;font-weight:400;
}
.footer-col ul{list-style:none;display:grid;gap:.7rem}
.footer-col a{font-size:.94rem;color:rgba(247,245,242,.85);position:relative;width:fit-content}
.footer-col a::after{content:"";position:absolute;left:0;bottom:-2px;height:1px;width:100%;background:var(--sage);transform:scaleX(0);transform-origin:right;transition:transform .4s var(--ease-out)}
.footer-col a:hover::after{transform:scaleX(1);transform-origin:left}
.footer-bottom{
  border-top:1px solid var(--hairline-light);
  padding-block:1.4rem;
  display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;
  font-family:var(--font-mono);font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;
  color:rgba(247,245,242,.55);
}

/* ============================================================
   Responsive
   ============================================================ */
@media (max-width:960px){
  .hero-grid{grid-template-columns:1fr}
  .hero-side{max-width:36rem}
  .section-head{grid-template-columns:1fr;gap:1.2rem}
  .section-head .lede{grid-column:1;margin-top:0}
  .service{grid-template-columns:1fr auto;grid-template-rows:auto auto}
  .service p{grid-column:1/-1}
  .about-grid,.contact-grid{grid-template-columns:1fr}
  .about-lead{position:static;top:auto}
  .footer-top{grid-template-columns:1fr 1fr}
  .footer-brand{grid-column:1/-1}
}
@media (max-width:720px){
  .nav-links{
    position:fixed;inset:0;background:var(--paper);
    flex-direction:column;justify-content:center;gap:2.2rem;
    transform:translateY(-100%);transition:transform .55s var(--ease-out);
    z-index:105;
  }
  .nav-links.open{transform:none}
  .nav-links a{font-family:var(--font-display);font-size:1.9rem;font-weight:400}
  .nav-links .nav-cta{font-family:var(--font-mono);font-size:.8rem}
  .menu-btn{display:flex}
}
</style>
</head>
<body>

<header class="site-header" id="top">
  <div class="wrap">
    <a class="logo" href="#top" aria-label="Canvas, home">Canvas<span class="dot" aria-hidden="true"></span></a>
    <button class="menu-btn" aria-expanded="false" aria-controls="nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
    <nav aria-label="Primary">
      <ul class="nav-links" id="nav">
        <li><a href="#top" data-nav>Home</a></li>
        <li><a href="#services" data-nav>Services</a></li>
        <li><a href="#about" data-nav>About</a></li>
        <li><a href="#contact" class="nav-cta">Start a project</a></li>
      </ul>
    </nav>
  </div>
</header>

<main>

<!-- ============ HERO ============ -->
<section class="hero">
  <div class="wrap hero-grid">
    <h1>
      <span class="line"><span>We create</span></span>
      <span class="line"><span>brands people</span></span>
      <span class="line"><span><em>remember.
        <svg class="stroke-u" viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true">
          <path d="M4 16 C 60 6, 130 20, 190 12 S 280 8, 296 14"/>
        </svg>
      </em></span></span>
    </h1>
    <div class="hero-side">
      <p class="hero-kicker">Design · Branding · Websites · Marketing</p>
      <p>Canvas is a boutique creative agency in Guernsey. We partner with ambitious businesses to build brands through strategy, design, photography and marketing that works as hard as you do.</p>
      <a class="btn" href="#contact"><span>Start a project</span><span class="arr" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<!-- ============ STRIP ============ -->
