<script>
/* ============================================================
   Canvas - site behaviour
   Organised as small, single-purpose modules.
   ============================================================ */
(function () {
  'use strict';

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- Header: condense on scroll, hide on fast scroll-down ---------- */
  const header = document.querySelector('.site-header');
  let lastY = window.scrollY;

  function onScroll() {
    const y = window.scrollY;
    header.classList.toggle('scrolled', y > 24);
    // hide only when moving down past the hero; always show near the top
    if (y > 600 && y - lastY > 6) header.classList.add('hidden-up');
    else if (lastY - y > 4 || y < 600) header.classList.remove('hidden-up');
    lastY = y;
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  /* ---------- Mobile menu ---------- */
  const menuBtn = document.querySelector('.menu-btn');
  const navList = document.getElementById('nav');

  function closeMenu() {
    navList.classList.remove('open');
    menuBtn.setAttribute('aria-expanded', 'false');
    menuBtn.setAttribute('aria-label', 'Open menu');
    document.body.style.overflow = '';
  }
  menuBtn.addEventListener('click', () => {
    const open = navList.classList.toggle('open');
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.style.overflow = open ? 'hidden' : '';
  });
  navList.addEventListener('click', (e) => {
    if (e.target.tagName === 'A') closeMenu();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && navList.classList.contains('open')) closeMenu();
  });

  /* ---------- Scroll-spy: underline the section in view ---------- */
  const spyLinks = document.querySelectorAll('[data-nav]');
  const spyMap = new Map();
  spyLinks.forEach((a) => {
    const id = a.getAttribute('href').slice(1);
    const el = id === 'top' ? document.body : document.getElementById(id);
    if (el) spyMap.set(el, a);
  });
  if ('IntersectionObserver' in window) {
    const spy = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          spyLinks.forEach((a) => a.removeAttribute('aria-current'));
          const link = spyMap.get(entry.target);
          if (link) link.setAttribute('aria-current', 'true');
        }
      });
    }, { rootMargin: '-40% 0px -55% 0px' });
    spyMap.forEach((_, el) => { if (el !== document.body) spy.observe(el); });
  }

  /* ---------- Reveal on scroll ---------- */
  const revealables = document.querySelectorAll('.r, .reveal-img, .step');
  if (prefersReduced || !('IntersectionObserver' in window)) {
    revealables.forEach((el) => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.18, rootMargin: '0px 0px -6% 0px' });
    revealables.forEach((el) => io.observe(el));
  }

  /* ---------- Process spine: line draws itself with scroll ---------- */
  const spine = document.getElementById('spinePath');
  const flow = document.querySelector('.process-flow');
  if (spine && flow && !prefersReduced) {
    function drawSpine() {
      const rect = flow.getBoundingClientRect();
      const vh = window.innerHeight;
      // progress: 0 when the flow enters, 1 when its bottom nears mid-viewport
      const total = rect.height + vh * 0.4;
      const passed = Math.min(Math.max(vh * 0.7 - rect.top, 0), total);
      const p = passed / total;
      spine.style.strokeDashoffset = String(1 - p);
    }
    window.addEventListener('scroll', drawSpine, { passive: true });
    window.addEventListener('resize', drawSpine);
    drawSpine();
  } else if (spine) {
    spine.style.strokeDashoffset = '0';
  }

  /* ---------- Subtle hero parallax (desktop, motion-safe only) ---------- */
  const heroH1 = document.querySelector('.hero h1');
  if (heroH1 && !prefersReduced && window.matchMedia('(min-width: 960px)').matches) {
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      if (y < window.innerHeight) {
        heroH1.style.transform = 'translateY(' + y * 0.08 + 'px)';
        heroH1.style.opacity = String(1 - y / (window.innerHeight * 1.15));
      }
    }, { passive: true });
  }

  /* ---------- Contact form ---------- */
  const form = document.getElementById('contactForm');
  const sent = document.getElementById('formSent');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    // simple client-side validation with native messages
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    // demo site: no backend - show confirmation and reset
    sent.classList.add('show');
    form.reset();
    sent.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block: 'nearest' });
  });
})();
</script>
